{
  "name": "hospital-portal-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end tests for Hospital Portal using Playwright",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:imaging": "playwright test ../apps/hospital-portal-web/tests/e2e/imaging-workflow.spec.ts",
    "test:imaging:headed": "playwright test ../apps/hospital-portal-web/tests/e2e/imaging-workflow.spec.ts --headed",
    "test:imaging:debug": "playwright test ../apps/hospital-portal-web/tests/e2e/imaging-workflow.spec.ts --debug",
    "test:performance": "playwright test tests/e2e/performance-review.spec.js",
    "test:training": "playwright test tests/e2e/training-compliance.spec.js",
    "test:realtime": "playwright test tests/e2e/branch-capacity-realtime.spec.js",
    "test:report": "playwright show-report",
    "test:codegen": "playwright codegen http://localhost:3000"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
